# SolarSage — console (Next.js) configuration.
#
# Copy to .env.local for local development. The backend has its own template at
# the repository root: see .env.example.
#
# Nothing here is prefixed NEXT_PUBLIC_, and that is deliberate: every call to
# the API is made from this app's server, never from the browser, so neither the
# backend URL nor the token is ever shipped to a page.

# Where the FastAPI backend lives, with no trailing slash.
# Local: http://127.0.0.1:8000   Production: your deployed API's HTTPS origin.
API_URL=http://127.0.0.1:8000

# Must match API_TOKEN on the backend deployment. When the backend has one set,
# every analyse / spray / settings call needs it; reads stay open either way.
# REQUIRED in production, because the backend should not accept anonymous writes.
API_TOKEN=

# How long a read waits before the console gives up and renders its demo dataset
# instead of an error page. Lower means a dead backend degrades faster; higher
# means a slow one still gets a chance to answer. Default: 6000
API_TIMEOUT_MS=

# How long a write waits. Longer than a read on purpose: a spray that timed out
# in the browser may still have opened the valve, so it is given room to finish.
# Default: 25000
API_WRITE_TIMEOUT_MS=
