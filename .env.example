# SolarSage — backend (FastAPI) configuration.
#
# Copy to .env for local development. Every value here has a working default, so
# the API starts with none of them set; each line says what changes if you do set
# it. Never commit the real .env — .gitignore already excludes it.
#
# The console (web/) has its own template: see web/.env.example.

# ---------------------------------------------------------------- security ---

# Shared secret guarding every route that changes something — analyse, spray,
# settings, refill. Reads stay open either way. Unset means writes are open to
# anyone who can reach the API, which is fine on a laptop and NOT fine on a
# deployment: a stranger can open the valve.
#
# REQUIRED in production. Must match API_TOKEN on the console deployment.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Browser origins allowed to call this API directly, comma-separated. The console
# calls the API from its server rather than the browser, so it does not need an
# entry here — this is only for anything talking to the API from a page.
# Default: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=

# ----------------------------------------------------------------- storage ---

# Where the SQLite database and decision snapshots are written. Must be a
# writable path. Serverless hosts only allow /tmp, and the code already defaults
# there when it detects one, so this normally stays unset.
# Default: Backend/data locally, /tmp/solarsage on Vercel or Lambda.
DATA_DIR=

# Full path to the SQLite file, if you want it somewhere other than
# <DATA_DIR>/solar_panel_system.db.
SQLITE_DATABASE_PATH=

# Read-only fixtures shipped with the repository, never written to. Point these
# elsewhere only if you keep the panel frames or the ESP32 captures outside the
# repo. Defaults: Backend/data/images and Hardware
IMAGE_DIR=
HARDWARE_DIR=

# ------------------------------------------------------------------- demo ----

# Seed an empty database with synthetic panel history on first boot, so a console
# deployed without hardware behind it shows a working system rather than four
# untested panels. The console labels any database seeded this way.
# Set false to leave an empty database empty. Default: true
DEMO_DATA=

# --------------------------------------------------------------- hardware ----

# Physical water tank size, in millilitres. Default: 5000
WATER_TANK_CAPACITY_ML=

# Panels the system manages, as a JSON array. Each needs a matching fixture at
# Backend/data/images/<id>_test.jpg for the classifier to have a frame to score.
# Default: ["panel_01","panel_02","panel_03","panel_04"]
PANEL_IDS=

# ------------------------------------------------------------------ server ---

# Only used by `python run_system.py` / uvicorn locally. A deployment supplies
# its own host and port. Defaults: 0.0.0.0 and 8000
API_HOST=
API_PORT=
